# Database
# Local SQLite default (zero setup needed for development):
DATABASE_URL=sqlite:///./resumo.db
# Production PostgreSQL (e.g., Render Postgres, Neon, Supabase, Railway):
# DATABASE_URL=postgresql+psycopg://username:password@hostname:5432/databasename

# Security / Authentication
JWT_SECRET=supersecret-resumo-jwt-key-change-in-production

# CORS (comma-separated list of allowed origins; Vercel and localhost are supported)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app

# Google Gemini AI (for resume optimization & keyword matching)
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Configuration (optional, for sending live password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_FROM=your_email@gmail.com
