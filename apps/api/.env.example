# SQLite (default, zero setup needed)
DATABASE_URL=sqlite:///./resumo.db
# PostgreSQL (optional, if running via Docker: docker compose up -d)
# DATABASE_URL=postgresql+psycopg://resumo:resumo_dev@localhost:5432/resumo

JWT_SECRET=supersecret-resumo-jwt-key-change-in-production
CORS_ORIGINS=http://localhost:3000
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Configuration (optional, for sending live password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_FROM=your_email@gmail.com

